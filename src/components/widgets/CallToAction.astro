---
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  tagline?: string;
  isDark?: boolean;
}

const {
  id,
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  isDark = false,
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass="max-w-6xl mx-auto">
  <div class="relative max-w-4xl mx-auto text-center px-6 py-12 md:py-16 rounded-3xl overflow-hidden bg-[#f7f6f4] dark:bg-white/5 border border-black/5 dark:border-white/10">

    <div class="relative">
      <Headline
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        classes={{
          container: 'mb-0 md:mb-0 max-w-2xl',
          title: 'text-3xl md:text-4xl font-bold tracking-tight mb-4',
          subtitle: 'text-xl',
        }}
      />
      <div class="mt-8 flex justify-center">
        <slot name="badge" />
      </div>
    </div>
  </div>
</WidgetWrapper>
