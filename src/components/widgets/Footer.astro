---
import { Icon } from 'astro-icon/components';

interface Link {
  text: string;
  href: string;
  ariaLabel?: string;
  icon?: string;
}

export interface Props {
  links?: Array<{ title: string; links: Array<Link> }>;
  socialLinks?: Array<Link>;
  footNote?: string;
}

const { links = [], socialLinks = [], footNote = '' } = Astro.props;
---

<footer class="relative border-t border-black/5 dark:border-white/10">
  <div class="absolute inset-0 pointer-events-none bg-gray-50 dark:bg-white/[0.02]" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-10 md:py-14">
      <div class="col-span-12 lg:col-span-5">
        <a class="inline-flex items-center gap-2.5 font-bold text-lg text-heading mb-3" href="/">
          <img src="/app-icon.png" alt="花況地圖 App 圖示" width="40" height="40" class="rounded-xl shadow-sm" />
          <span>花況地圖</span>
        </a>
        <p class="text-sm text-muted max-w-sm">
          FlowerConditionMap — 即時記錄與分享各地花況，讓每一次賞花都遇上最好的時機。
        </p>
      </div>

      {
        links.map(({ title, links: groupLinks }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="font-medium text-heading mb-2">{title}</div>
            <ul class="text-sm space-y-2">
              {groupLinks.map(({ text, href, ariaLabel }) => (
                <li>
                  <a
                    class="text-muted hover:text-primary transition duration-150 ease-in-out"
                    href={href}
                    aria-label={ariaLabel}
                  >
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="md:flex md:items-center md:justify-between py-6 border-t border-black/5 dark:border-white/10">
      {
        socialLinks.length > 0 && (
          <ul class="flex mb-4 md:order-1 md:ml-4 md:mb-0">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-muted hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel ?? text}
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="text-sm text-muted">
        <Fragment set:html={footNote} />
      </div>
    </div>
  </div>
</footer>
