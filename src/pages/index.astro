---
import '../styles/global.css';
---

<html lang="zh-TW">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>FlowerConditionMap - 花況地圖 | 即時賞花資訊分享平台</title>
		<meta name="description" content="FlowerConditionMap 讓您即時記錄和分享各地的花況資訊，在互動式地圖上查看其他人分享的賞花照片。AI 輔助辨識、時間軸回放，掌握最佳賞花時機。" />
	</head>
	<body class="bg-gradient-pink-green">

		<!-- Hero Section -->
		<header class="min-vh-100 d-flex align-items-center py-5">
			<div class="container">
				<div class="row justify-content-center text-center">
					<div class="col-lg-10">
						<!-- App Icon -->
						<div class="mb-4">
							<div class="d-inline-flex align-items-center justify-content-center app-icon rounded-4xl shadow-lg" style="width: 96px; height: 96px; font-size: 3rem;">
								🌸
							</div>
						</div>

						<!-- Title -->
						<h1 class="display-1 fw-bold mb-4 text-gradient">
							花況地圖
						</h1>

						<!-- Subtitle -->
						<p class="fs-3 text-dark mb-3">
							即時記錄與分享賞花資訊
						</p>

						<p class="fs-5 text-secondary mb-5 px-lg-5">
							透過 AI 輔助辨識、智能審核機制和時間軸回放，幫助賞花愛好者掌握最佳賞花時機和地點
						</p>

						<!-- App Store Badge -->
						<div class="d-flex justify-content-center">
							<a href="#" class="text-decoration-none">
								<img src="/app-store-badge.svg" alt="Download on the App Store" height="50" class="hover-opacity">
							</a>
						</div>
					</div>
				</div>
			</div>
		</header>

		<!-- Features Section -->
		<section class="py-5 backdrop-blur">
			<div class="container py-5">
				<div class="row justify-content-center mb-5">
					<div class="col-lg-8 text-center">
						<h2 class="display-4 fw-bold mb-3">主要功能</h2>
						<p class="fs-5 text-secondary">完整的賞花體驗，從記錄到分享</p>
					</div>
				</div>

				<div class="row g-4">
					<!-- Feature 1 -->
					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border-0 shadow-sm bg-gradient-feature-1 rounded-4xl">
							<div class="card-body p-4">
								<div class="fs-1 mb-3">🗺️</div>
								<h3 class="h4 fw-bold mb-3">即時花況地圖</h3>
								<p class="text-secondary mb-0">
									在互動式地圖上即時顯示周圍的花況照片標記，支援智能叢集和 GPS 定位服務
								</p>
							</div>
						</div>
					</div>

					<!-- Feature 2 -->
					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border-0 shadow-sm bg-gradient-feature-2 rounded-4xl">
							<div class="card-body p-4">
								<div class="fs-1 mb-3">⏱️</div>
								<h3 class="h4 fw-bold mb-3">時間軸回放</h3>
								<p class="text-secondary mb-0">
									獨家功能！播放最近 10 天的花況變化動畫，直觀了解花期變化趨勢
								</p>
							</div>
						</div>
					</div>

					<!-- Feature 3 -->
					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border-0 shadow-sm bg-gradient-feature-3 rounded-4xl">
							<div class="card-body p-4">
								<div class="fs-1 mb-3">📸</div>
								<h3 class="h4 fw-bold mb-3">智能照片標記</h3>
								<p class="text-secondary mb-0">
									AI 輔助辨識花種和花況，自動提取 GPS 座標，支援 18 種花卉植物
								</p>
							</div>
						</div>
					</div>

					<!-- Feature 4 -->
					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border-0 shadow-sm bg-gradient-feature-4 rounded-4xl">
							<div class="card-body p-4">
								<div class="fs-1 mb-3">🏔️</div>
								<h3 class="h4 fw-bold mb-3">智能地點解析</h3>
								<p class="text-secondary mb-0">
									針對台灣、日本等不同國家使用專屬關鍵字搜尋策略，精準標記地點
								</p>
							</div>
						</div>
					</div>

					<!-- Feature 5 -->
					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border-0 shadow-sm bg-gradient-feature-5 rounded-4xl">
							<div class="card-body p-4">
								<div class="fs-1 mb-3">🔍</div>
								<h3 class="h4 fw-bold mb-3">歷史資料回退</h3>
								<p class="text-secondary mb-0">
									當最近無資料時，自動查詢去年同期的滿開照片，全年都能參考花況
								</p>
							</div>
						</div>
					</div>

					<!-- Feature 6 -->
					<div class="col-md-6 col-lg-4">
						<div class="card h-100 border-0 shadow-sm bg-gradient-feature-6 rounded-4xl">
							<div class="card-body p-4">
								<div class="fs-1 mb-3">🛡️</div>
								<h3 class="h4 fw-bold mb-3">社群監督機制</h3>
								<p class="text-secondary mb-0">
									照片檢舉功能和智能審核系統，確保平台資訊準確可靠
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Flower Types Section -->
		<section class="py-5">
			<div class="container py-5">
				<div class="row justify-content-center mb-5">
					<div class="col-lg-8 text-center">
						<h2 class="display-4 fw-bold mb-3">支援 18 種花卉</h2>
						<p class="fs-5 text-secondary">依季節分類，涵蓋春夏秋冬四季美景</p>
					</div>
				</div>

				<div class="row g-4">
					<!-- Spring -->
					<div class="col-md-6 col-lg-3">
						<div class="card h-100 border-0 season-spring rounded-4xl">
							<div class="card-body p-4">
								<h3 class="h4 fw-bold mb-4 text-pink-700">🌸 春季</h3>
								<ul class="list-unstyled mb-0">
									<li class="mb-2"><span class="me-2">🌸</span> 櫻花</li>
									<li class="mb-2"><span class="me-2">🌼</span> 油菜花</li>
									<li class="mb-2"><span class="me-2">🌺</span> 杜鵑花</li>
									<li class="mb-2"><span class="me-2">✿</span> 梅花</li>
									<li class="mb-2"><span class="me-2">🌸</span> 桃花</li>
									<li class="mb-0"><span class="me-2">💜</span> 紫藤</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- Summer -->
					<div class="col-md-6 col-lg-3">
						<div class="card h-100 border-0 season-summer rounded-4xl">
							<div class="card-body p-4">
								<h3 class="h4 fw-bold mb-4 text-blue-700">☀️ 夏季</h3>
								<ul class="list-unstyled mb-0">
									<li class="mb-2"><span class="me-2">💙</span> 繡球花</li>
									<li class="mb-2"><span class="me-2">🌻</span> 向日葵</li>
									<li class="mb-2"><span class="me-2">💜</span> 薰衣草</li>
									<li class="mb-2"><span class="me-2">🪷</span> 蓮花</li>
									<li class="mb-0"><span class="me-2">🌺</span> 鳳凰木</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- Autumn -->
					<div class="col-md-6 col-lg-3">
						<div class="card h-100 border-0 season-autumn rounded-4xl">
							<div class="card-body p-4">
								<h3 class="h4 fw-bold mb-4 text-orange-700">🍂 秋季</h3>
								<ul class="list-unstyled mb-0">
									<li class="mb-2"><span class="me-2">🍁</span> 楓葉</li>
									<li class="mb-2"><span class="me-2">🌾</span> 芒草</li>
									<li class="mb-2"><span class="me-2">🌸</span> 波斯菊</li>
									<li class="mb-0"><span class="me-2">🌼</span> 金針花</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- Winter -->
					<div class="col-md-6 col-lg-3">
						<div class="card h-100 border-0 season-winter rounded-4xl">
							<div class="card-body p-4">
								<h3 class="h4 fw-bold mb-4 text-warning">❄️ 冬季</h3>
								<ul class="list-unstyled mb-0">
									<li class="mb-2"><span class="me-2">🍂</span> 銀杏</li>
									<li class="mb-2"><span class="me-2">🌺</span> 茶花</li>
									<li class="mb-0"><span class="me-2">🌲</span> 落羽松</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Use Cases Section -->
		<section class="py-5" style="background: linear-gradient(to bottom, #ffffff, #f0fdf4);">
			<div class="container py-5">
				<div class="row justify-content-center mb-5">
					<div class="col-lg-8 text-center">
						<h2 class="display-4 fw-bold mb-3">適用場景</h2>
						<p class="fs-5 text-secondary">不只是賞花，更是生活美學的記錄</p>
					</div>
				</div>

				<div class="row g-4">
					<div class="col-md-4">
						<div class="text-center">
							<div class="d-inline-flex align-items-center justify-content-center use-case-icon-1 rounded-circle shadow-lg mb-4" style="width: 80px; height: 80px; font-size: 2.5rem;">
								🌺
							</div>
							<h3 class="h4 fw-bold mb-3">賞花愛好者</h3>
							<p class="text-secondary">
								查詢附近花況，規劃賞花行程，分享美好體驗
							</p>
						</div>
					</div>

					<div class="col-md-4">
						<div class="text-center">
							<div class="d-inline-flex align-items-center justify-content-center use-case-icon-2 rounded-circle shadow-lg mb-4" style="width: 80px; height: 80px; font-size: 2.5rem;">
								🗺️
							</div>
							<h3 class="h4 fw-bold mb-3">旅遊規劃</h3>
							<p class="text-secondary">
								掌握不同地區花期，發現熱門景點，預測最佳時機
							</p>
						</div>
					</div>

					<div class="col-md-4">
						<div class="text-center">
							<div class="d-inline-flex align-items-center justify-content-center use-case-icon-3 rounded-circle shadow-lg mb-4" style="width: 80px; height: 80px; font-size: 2.5rem;">
								📷
							</div>
							<h3 class="h4 fw-bold mb-3">攝影愛好者</h3>
							<p class="text-secondary">
								尋找絕佳拍攝地點，掌握最佳拍攝時機，分享精彩作品
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-5">
			<div class="container py-5">
				<div class="row justify-content-center text-center">
					<div class="col-lg-8">
						<h2 class="display-4 fw-bold mb-4">開始您的賞花之旅</h2>
						<p class="fs-5 text-secondary mb-5">
							立即下載，探索身邊的花卉美景
						</p>

						<a href="#" class="btn btn-gradient btn-lg rounded-pill shadow-lg px-5 py-3 fs-5">
							免費下載 FlowerConditionMap
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-5 bg-dark text-white">
			<div class="container">
				<div class="text-center">
					<div class="fs-1 mb-3">🌸</div>
					<p class="text-white-50 mb-2">FlowerConditionMap - 花況地圖</p>
					<p class="text-white-50 small mb-0">© 2026 FlowerConditionMap. All rights reserved.</p>
				</div>
			</div>
		</footer>

		<!-- Bootstrap Bundle with Popper -->
		<script>
			import 'bootstrap/dist/js/bootstrap.bundle.min.js';
		</script>

	</body>
</html>
