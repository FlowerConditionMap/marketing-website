---
import Button from '~/components/ui/Button.astro';

export interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  tagline?: string;
  actions?: Array<Record<string, unknown>>;
}

const {
  id,
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  actions = [],
} = Astro.props;
---

<section class="relative md:-mt-[76px]" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <slot name="bg" />
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20 lg:py-24">
      <div class="text-center max-w-5xl mx-auto">
        <div class="mb-6 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <img
            src="/app-icon.png"
            alt="花況地圖 App 圖示"
            width="112"
            height="112"
            class="mx-auto rounded-[26px] shadow-xl shadow-pink-500/20 ring-1 ring-black/5"
          />
        </div>

        {
          tagline && (
            <p
              class="text-base text-primary font-bold tracking-wide uppercase mb-3 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              set:html={tagline}
            />
          )
        }

        {
          title && (
            <h1
              class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight tracking-tight mb-6 font-heading text-heading intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              set:html={title}
            />
          )
        }

        <div class="max-w-3xl mx-auto">
          {
            subtitle && (
              <p
                class="text-xl text-muted mb-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                set:html={subtitle}
              />
            )
          }

          {
            actions.length > 0 && (
              <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                {actions.map((action) => (
                  <div class="flex w-full sm:w-auto">
                    <Button {...action} class="w-full sm:mb-0" />
                  </div>
                ))}
              </div>
            )
          }

          <div class="mt-10 flex justify-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <slot name="badge" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
