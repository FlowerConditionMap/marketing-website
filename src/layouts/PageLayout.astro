---
import '~/styles/global.css';

import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Intersect from '~/components/common/Intersect.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

export interface Props {
  title: string;
  description: string;
  headerLinks?: Array<{ text: string; href: string }>;
  footerLinks?: Array<{ title: string; links: Array<{ text: string; href: string }> }>;
}

const { title, description } = Astro.props;

const headerLinks = Astro.props.headerLinks ?? [
  { text: '主要功能', href: '#features' },
  { text: '支援花卉', href: '#flowers' },
  { text: '花期階段', href: '#stages' },
  { text: '適用場景', href: '#use-cases' },
];

const footerLinks = Astro.props.footerLinks ?? [
  {
    title: '產品',
    links: [
      { text: '主要功能', href: '#features' },
      { text: '支援花卉', href: '#flowers' },
      { text: '適用場景', href: '#use-cases' },
    ],
  },
  {
    title: '法律',
    links: [{ text: '使用條款', href: '/terms' }],
  },
];
---

<html lang="zh-TW" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#be3455" />
    <ApplyColorMode />
  </head>

  <body class="antialiased font-sans tracking-tight bg-page text-default">
    <Header links={headerLinks} isSticky showToggleTheme />

    <main>
      <slot />
    </main>

    <Footer
      links={footerLinks}
      footNote="© 2026 FlowerConditionMap. All rights reserved."
    />

    <Intersect />
  </body>
</html>
