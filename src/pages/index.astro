---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Seasons from '~/components/widgets/Seasons.astro';
import Steps from '~/components/widgets/Steps.astro';
import UseCases from '~/components/widgets/UseCases.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';

const testFlightUrl = 'https://testflight.apple.com/join/nMGEHpjF';

const metadata = {
  title: '花況地圖 FlowerConditionMap｜即時賞花資訊分享平台',
  description:
    'FlowerConditionMap 讓您即時記錄和分享各地的花況資訊，在互動式地圖上查看其他人分享的賞花照片。花況分級、時間軸回放，掌握最佳賞花時機。',
};
---

<PageLayout title={metadata.title} description={metadata.description}>
  <!-- Hero ****************** -->

  <Hero
    tagline="即時賞花資訊分享平台"
    actions={[{ variant: 'primary', text: '加入 TestFlight 搶先試用', href: testFlightUrl, target: '_blank', icon: 'tabler:brand-apple' }]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-b from-pink-50 via-white to-emerald-50 dark:from-[#1a0f1d] dark:via-[#0f0a14] dark:to-[#0b1410]"></div>
      <div class="absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full bg-pink-300/30 dark:bg-pink-500/10 blur-3xl"></div>
      <div class="absolute top-32 -right-24 w-[26rem] h-[26rem] rounded-full bg-emerald-300/30 dark:bg-emerald-500/10 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/3 w-[24rem] h-[24rem] rounded-full bg-purple-300/20 dark:bg-purple-500/10 blur-3xl"></div>
    </Fragment>

    <Fragment slot="title">
      花況地圖，<br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-pink-600 via-purple-500 to-emerald-600 dark:from-pink-400 dark:via-purple-300 dark:to-emerald-400 bg-clip-text text-transparent">
        讓你不再錯過花期
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      在互動式地圖上即時查看各地花況照片，透過花況分級與時間軸回放，掌握最佳賞花時機和地點。
    </Fragment>

    <Fragment slot="badge">
      <a href="#" aria-label="從 App Store 下載花況地圖" class="transition hover:opacity-80">
        <img src="/app-store-badge.svg" alt="Download on the App Store" height="54" class="h-[54px] w-auto" />
      </a>
    </Fragment>
  </Hero>

  <!-- Features ****************** -->

  <Features
    id="features"
    tagline="主要功能"
    title="完整的賞花體驗，從記錄到分享"
    subtitle="從照片上傳、地圖瀏覽到花況趨勢，一個 App 全部搞定"
    columns={3}
    items={[
      {
        title: '花況地圖',
        description:
          '自動讀取照片內的 GPS 資訊標記拍攝地點，在互動式地圖上瀏覽各地花況，快速掌握附近哪裡正在開花',
        icon: 'tabler:map-2',
        accent: 'bg-gradient-to-br from-pink-400 to-rose-500',
      },
      {
        title: '花況分級顯示',
        description:
          '每種花卉依生長特性設計專屬花況分級（如含苞、盛開、花吹雪、轉紅、落葉等），一眼看出各地花況進度，掌握最佳賞花時機',
        icon: 'tabler:flower',
        accent: 'bg-gradient-to-br from-amber-400 to-orange-500',
      },
      {
        title: '即時時間軸瀏覽',
        description:
          '獨家功能！以動畫方式播放近期花況照片變化，時間範圍依花種花期自動調整，逐日呈現花況擴散趨勢，一眼看懂目前的開花進度',
        icon: 'tabler:player-play',
        accent: 'bg-gradient-to-br from-violet-400 to-purple-600',
      },
      {
        title: '歷史資料回退',
        description: '當最近無資料時，自動查詢去年同期的滿開照片，全年都能參考花況',
        icon: 'tabler:history',
        accent: 'bg-gradient-to-br from-sky-400 to-blue-600',
      },
      {
        title: '收藏喜愛地點',
        description: '一鍵收藏賞花地點，依花種篩選管理收藏清單，隨時掌握回訪時機',
        icon: 'tabler:heart',
        accent: 'bg-gradient-to-br from-rose-400 to-pink-600',
      },
      {
        title: '社群監督機制',
        description: '照片檢舉功能和智能審核系統，確保平台資訊準確可靠',
        icon: 'tabler:shield-check',
        accent: 'bg-gradient-to-br from-emerald-400 to-green-600',
      },
    ]}
  />

  <!-- Seasons ****************** -->

  <Seasons
    id="flowers"
    tagline="支援花卉"
    title="6 種花卉，四季都有景可賞"
    subtitle="依季節分類，涵蓋春夏秋冬的代表性花況"
    isDark={false}
    items={[
      {
        season: '春季',
        emoji: '🌸',
        accent: 'bg-gradient-to-br from-pink-100 to-pink-200 dark:from-pink-500/15 dark:to-pink-500/5',
        flowers: [
          { emoji: '🌸', name: '櫻花' },
          { emoji: '🪻', name: '紫藤' },
        ],
      },
      {
        season: '夏季',
        emoji: '☀️',
        accent: 'bg-gradient-to-br from-sky-100 to-blue-200 dark:from-sky-500/15 dark:to-sky-500/5',
        flowers: [{ emoji: '🌺', name: '鳳凰木' }],
      },
      {
        season: '秋季',
        emoji: '🍂',
        accent: 'bg-gradient-to-br from-orange-100 to-orange-200 dark:from-orange-500/15 dark:to-orange-500/5',
        flowers: [{ emoji: '🍁', name: '楓葉' }],
      },
      {
        season: '冬季',
        emoji: '❄️',
        accent: 'bg-gradient-to-br from-amber-100 to-yellow-200 dark:from-amber-500/15 dark:to-amber-500/5',
        flowers: [
          { emoji: '🍂', name: '銀杏' },
          { emoji: '🌲', name: '落羽松' },
        ],
      },
    ]}
  />

  <!-- Steps ****************** -->

  <Steps
    id="stages"
    tagline="花期全階段"
    title="從行前規劃到花期尾聲，都用得上"
    subtitle="依當下花況給你不同的賞花建議"
    items={[
      {
        title: '花期前・提前規劃',
        description: '出發前查看歷史花況紀錄，掌握過往哪些地點看得到花，提前排好旅遊行程',
        icon: 'tabler:calendar-event',
      },
      {
        title: '花期初期・掌握開花進度',
        description: '抵達當地正值花期剛開始，即時查看哪裡已經開花、哪裡還含苞待放，抓緊時機前往',
        icon: 'tabler:seeding',
      },
      {
        title: '花期盛開・發掘私房景點',
        description: '花期正盛時，除了熱門大景點，還能發現其他人分享的私房賞花地點，避開人潮盡情賞花',
        icon: 'tabler:flower',
      },
      {
        title: '花期末段・把握最後美景',
        description: '就算晚到也不錯過：查看哪裡花還未謝，或欣賞櫻吹雪、銀杏黃金地毯等花期尾聲限定的景色',
        icon: 'tabler:wind',
      },
    ]}
  >
    <Fragment slot="aside">
      <div class="relative w-full max-w-sm aspect-square rounded-3xl overflow-hidden bg-gradient-to-br from-pink-100 via-white to-emerald-100 dark:from-pink-500/10 dark:via-white/5 dark:to-emerald-500/10 border border-black/5 dark:border-white/10 shadow-lg flex items-center justify-center">
        <div class="absolute -top-10 -right-10 w-56 h-56 rounded-full bg-pink-300/40 dark:bg-pink-500/20 blur-3xl"></div>
        <div class="absolute -bottom-10 -left-10 w-56 h-56 rounded-full bg-emerald-300/40 dark:bg-emerald-500/20 blur-3xl"></div>
        <div class="relative grid grid-cols-3 gap-5 text-4xl p-8" aria-hidden="true">
          <span>🗓️</span><span>🌱</span><span>🌸</span>
          <span>🍃</span><span>🗺️</span><span>📷</span>
          <span>🍁</span><span>🌲</span><span>🪻</span>
        </div>
      </div>
    </Fragment>
  </Steps>

  <!-- Use cases ****************** -->

  <UseCases
    id="use-cases"
    tagline="適用場景"
    title="不只是賞花，更是生活美學的記錄"
    items={[
      {
        title: '賞花愛好者',
        description: '查詢附近花況，規劃賞花行程，分享美好體驗',
        icon: 'tabler:flower',
        accent: 'bg-gradient-to-br from-pink-400 to-rose-500',
      },
      {
        title: '旅遊規劃',
        description: '掌握不同地區花期，發現熱門景點，預測最佳時機',
        icon: 'tabler:map-pin',
        accent: 'bg-gradient-to-br from-emerald-400 to-green-600',
      },
      {
        title: '攝影愛好者',
        description: '尋找絕佳拍攝地點，掌握最佳拍攝時機，分享精彩作品',
        icon: 'tabler:camera',
        accent: 'bg-gradient-to-br from-violet-400 to-purple-600',
      },
    ]}
  />

  <!-- CTA ****************** -->

  <CallToAction title="開始您的賞花之旅" subtitle="立即下載，探索身邊的花卉美景">
    <Fragment slot="badge">
      <div class="flex flex-col items-center gap-4">
        <Button variant="primary" text="加入 TestFlight 搶先試用" href={testFlightUrl} target="_blank" icon="tabler:brand-apple" />
        <a href="#" aria-label="從 App Store 下載花況地圖" class="transition hover:opacity-80">
          <img src="/app-store-badge.svg" alt="Download on the App Store" height="60" class="h-[60px] w-auto" />
        </a>
      </div>
    </Fragment>
  </CallToAction>
</PageLayout>
