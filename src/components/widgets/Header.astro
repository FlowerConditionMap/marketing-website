---
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

interface Link {
  text: string;
  href: string;
}

export interface Props {
  id?: string;
  links?: Array<Link>;
  actions?: Array<Record<string, unknown>>;
  isSticky?: boolean;
  showToggleTheme?: boolean;
}

const { id = 'header', links = [], actions = [], isSticky = true, showToggleTheme = true } = Astro.props;
---

<fc-header>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-sticky-header': true } : {}}
    id={id}
  >
    <div class="absolute inset-0"></div>
    <div class="relative text-default py-3 px-3 md:px-6 mx-auto w-full md:flex md:justify-between max-w-7xl">
      <div class="flex justify-between">
        <a class="flex items-center gap-2.5 font-bold text-lg text-heading" href="/">
          <img src="/app-icon.png" alt="花況地圖" width="32" height="32" class="rounded-lg shadow-sm" />
          <span>花況地圖</span>
        </a>
        <div class="flex items-center md:hidden">
          <ToggleMenu />
        </div>
      </div>

      <nav
        class="items-center w-full md:w-auto hidden md:flex md:mx-5 text-default overflow-y-auto overflow-x-hidden md:overflow-visible"
        aria-label="主選單"
      >
        <ul
          class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium"
        >
          {
            links.map(({ text, href }) => (
              <li>
                <a class="hover:text-primary px-4 py-3 flex items-center whitespace-nowrap" href={href}>
                  {text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div
        class="hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 bottom-0 p-3 md:p-0"
      >
        <div class="items-center flex justify-between w-full md:w-auto">
          <div class="flex">
            {showToggleTheme && <ToggleTheme />}
          </div>
          {
            actions?.length ? (
              <span class="ml-4">
                {actions.map((btnProps) => (
                  <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
                ))}
              </span>
            ) : null
          }
        </div>
      </div>
    </div>
  </header>
</fc-header>

<style>
  fc-header {
    display: contents;
  }
</style>

<script>
  class FcHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('#header nav');
      const lastChild = this.querySelector<HTMLElement>('#header > div > div:last-child');

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded', 'bg-page');
        nav?.classList.add('hidden');
        lastChild?.classList.add('hidden');
      };

      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.classList.toggle('hidden');
        lastChild?.classList.toggle('hidden');
      });

      nav?.addEventListener('click', closeMenu);

      this.mql = window.matchMedia('(max-width: 767px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      if (header?.hasAttribute('data-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
    }
  }

  if (!customElements.get('fc-header')) {
    customElements.define('fc-header', FcHeader);
  }
</script>
